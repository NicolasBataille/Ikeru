          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikeru needs microphone access for shadowing exercises where you practice speaking Japanese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikeru a besoin d'accéder au micro pour les exercices de shadowing où tu t'entraînes à parler japonais."
          }
        }
      }
