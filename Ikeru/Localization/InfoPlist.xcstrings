    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikeru uses the camera to read Japanese text you photograph, so you can turn it into study cards. Photos stay on your device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikeru utilise l'appareil photo pour lire le texte japonais que tu photographies et le transformer en cartes. Les photos restent sur ton appareil."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
