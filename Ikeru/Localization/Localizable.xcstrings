    "SwipeTutorial.Idle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch — each direction means something different."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde — chaque direction veut dire quelque chose de différent."
          }
        }
      }
    },
    "SwipeTutorial.Intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To answer a card, swipe it in a direction. Each way tells me how easy it was for you — that's how I plan your reviews."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour répondre à une carte, fais-la glisser dans une direction. Chaque sens m'indique à quel point c'était facile — c'est comme ça que je planifie tes révisions."
          }
        }
      }
    },
    "Tour.Button.Back" : {
      "extractionState" : "manual",
