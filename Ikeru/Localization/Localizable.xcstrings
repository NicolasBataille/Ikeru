          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À revoir"
          }
        }
      }
    },
    "SwipeTutorial.Buttons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer not to swipe? The same four buttons sit at the bottom of the screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas envie de glisser ? Les quatre mêmes boutons sont aussi en bas de l'écran."
          }
        }
      }
    },
    "SwipeTutorial.Easy.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too easy — we'll wait much longer before asking again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop facile — on attendra bien plus longtemps avant de la redemander."
          }
        }
      }
    },
