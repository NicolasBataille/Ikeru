    "SwipeTutorial.Again.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You didn't know it — we'll bring it back very soon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne savais pas — on la revoit très vite."
          }
        }
