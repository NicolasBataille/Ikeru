    "Tour.Button.Start" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's go"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est parti"
          }
        }
      }
    },
    "Tour.Companion.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That little gold circle is me! Tap it from any screen to ask a question — I'll answer in plain English whenever you're stuck."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce petit rond doré, c'est moi ! Touche-le depuis n'importe quel écran pour poser une question — je réponds en français dès que tu bloques."
          }
        }
      }
    },
    "Tour.Companion.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me, your tutor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moi, ta tutrice"
          }
        }
      }
    },
    "Tour.Finish.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's the essentials! Pick your kana and dive in whenever you're ready — I'm never far. 頑張って (ganbatte) means \"good luck\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voilà l'essentiel ! Choisis tes kana et lance-toi quand tu te sens prêt — je ne suis jamais loin. 頑張って (ganbatte) veut dire « bon courage »."
          }
        }
      }
    },
    "Tour.Finish.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your turn!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À toi de jouer !"
          }
        }
      }
    },
    "Tour.Home.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dashboard. At a glance: today's session (your short daily review) and how far you've come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton tableau de bord. D'un coup d'œil : ta session du jour (ta petite révision quotidienne) et ta progression."
          }
        }
      }
    },
    "Tour.Home.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accueil"
          }
        }
      }
    },
    "Tour.RPG.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your game profile: earn experience, level up (段 \"dan\" — ranks, like in martial arts) and unlock rewards as you learn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton profil de jeu : gagne de l'expérience, monte de niveau (段 « dan » — des rangs, comme aux arts martiaux) et débloque des récompenses en apprenant."
          }
        }
      }
    },
    "Tour.RPG.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your progress"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta progression"
          }
        }
      }
    },
    "Tour.Session.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It all starts here. First pick your kana (仮名を選ぶ), then your daily session launches from this button. You'll ease in with hiragana — about 46 basic sounds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout commence ici. Choisis d'abord tes kana (仮名を選ぶ), puis ta session quotidienne se lance depuis ce bouton. On débute en douceur avec les hiragana — environ 46 sons de base."
          }
        }
      }
    },
    "Tour.Session.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start practising"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer à pratiquer"
          }
        }
      }
    },
    "Tour.Settings.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, reminders, and the AI that powers me. Tip: you can replay this tour from here anytime."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue, rappels, et l'IA qui me fait parler. Astuce : tu peux relancer cette visite d'ici quand tu veux."
          }
        }
      }
    },
    "Tour.Settings.Replay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replay the tour"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoir la visite guidée"
          }
        }
      }
    },
    "Tour.Settings.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages"
          }
        }
      }
    },
    "Tour.Study.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your exercises live here: writing, vocabulary, listening, kanji (the characters borrowed from Chinese)… They unlock gradually, at your pace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, tous tes exercices : écriture, vocabulaire, écoute, kanji (les caractères venus du chinois)… Ils se débloquent petit à petit, à ton rythme."
          }
        }
      }
    },
    "Tour.Study.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Study"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Étudier"
          }
        }
      }
    },
    "Tour.Welcome.Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll be your guide while you learn Japanese — no prior knowledge needed. Let me show you around in about 30 seconds. Ready?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vais t'accompagner dans ton apprentissage du japonais — aucune connaissance requise. Laisse-moi te faire visiter en 30 secondes. Prêt ?"
          }
        }
      }
    },
    "Tour.Welcome.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi, I'm Sakura!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enchantée, je suis Sakura !"
          }
        }
      }
    },
