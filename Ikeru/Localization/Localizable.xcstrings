          }
        }
      }
    },
    "Japanese serif typeface bundled with the app, used to render kanji and Japanese text on every device." : {
      "comment" : "AttributionView — Noto Serif JP entry description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
